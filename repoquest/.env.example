# Copy to .env.local. Every variable is optional and read on the server only.
# Never prefix secrets with NEXT_PUBLIC_ (that would ship them to browsers).

# GitHub personal access token (no scopes needed for public repos).
# Raises the GitHub API limit from 60 to 5,000 requests/hour. Strongly recommended in production.
GITHUB_TOKEN=

# Optional AI explanations. Leave empty to run RepoQuest without AI.
ANTHROPIC_API_KEY=
# anthropic | ollama | none  (default: anthropic when ANTHROPIC_API_KEY is set, otherwise none)
AI_PROVIDER=
# Model id. Defaults: claude-opus-5-5 (anthropic), llama3.1 (ollama). e.g. claude-haiku-5-5 for lower cost.
AI_MODEL=
# Free local models via Ollama (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
# Max AI explanations per client IP per hour (per server instance). Default 20.
AI_RATE_LIMIT_PER_HOUR=

# Public URL of your deployment (used for canonical links and social cards). Vercel sets this automatically.
NEXT_PUBLIC_SITE_URL=
# Link to the source repository shown in the header/footer.
NEXT_PUBLIC_REPO_URL=https://github.com/sriyansv/repoquest
